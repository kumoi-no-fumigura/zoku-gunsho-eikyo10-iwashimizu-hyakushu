   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "かそへねと隈なき空にみへてけり名におふ月の秋のわ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733557",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "望月",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "昨日見し最中の空をかはらぬと今宵は遅くいやよひのつき",

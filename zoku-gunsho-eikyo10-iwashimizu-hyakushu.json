   "speaker": "道〻",
   "page": 1,
   "pid": "nao-733557",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不知夜月",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "名にめてし夜半もまちかき俤の空に立まちの月のさやけて",
   "kana": "",
   "speaker": "義一",
   "page": 1,
   "pid": "nao-733557",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立待月",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "晴にけ雲峯にいさよふかきくも母はまちの月の影をいそけと",
   "kana": "",
   "speaker": "公保",
   "page": 2,
   "pid": "nao-733557",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "居待月",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "をきゐつゝたへてなかむる影をしもたれふし待の月といふらん",
   "kana": "",
   "speaker": "実量",
   "page": 2,
   "pid": "nao-733557",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "臥待月",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "ふして待起てこよひは又や見ん雲のはつかのやまのはの月",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733557",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二十日月雅世",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "高砂やつゐに紅葉ぬ松か有ても尾上に残るありあけの月",
   "kana": "",
   "speaker": "宗継",
   "page": 2,
   "pid": "nao-733557",
   "form": "短歌",
   "genre": "",
   "ban": "",
